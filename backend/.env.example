# AI provider: gemini or openai. If omitted, Gemini is used when GEMINI_API_KEY exists.
AI_PROVIDER=gemini

# PostgreSQL
DATABASE_URL=postgresql://ggads:ggads_local_password@localhost:5432/ggads
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false
DATABASE_SEED_ENABLED=true
ADMIN_EMAIL=admin@allsoft.local
# Required in production. Use at least 10 characters with upper/lowercase, number and symbol.
ADMIN_PASSWORD=ChangeMe@123456
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
DEFAULT_GOOGLE_ADS_CUSTOMER_ID=9920642691
AUTOMATION_WORKER_DISABLED=false
AUTOMATION_RUN_NOW_MAX_CHANGES=5000
AUTOMATION_STALE_RUNNING_MINUTES=30
CHANGE_REQUEST_STALE_MINUTES=30
AUTOMATION_POLL_INTERVAL_MS=60000
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
SYNC_QUEUE_WORKER_DISABLED=false
SYNC_QUEUE_POLL_INTERVAL_MS=2000
# Chỉ bật khi backend nằm sau reverse proxy đáng tin cậy.
TRUST_PROXY=false
# Required when the selected customer is a client account under an MCC/manager account.
# Use the manager customer ID without dashes, for example 9920642691.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI fallback, optional
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
